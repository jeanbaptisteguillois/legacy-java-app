{
  "name": "inventory-order-management",
  "version": "2.0.0",
  "private": true,
  "description": "Inventory & Order Management SPA — React 18 + TypeScript + Vite (migrated from AngularJS 1.5). The mock Express backend serves /api for local development and the Playwright suites.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock-backend": "PORT=4310 SERVE_STATIC=0 node test/mock-backend/server.js",
    "serve": "node test/mock-backend/server.js",
    "test:coverage": "playwright test --config=test/coverage/playwright.config.ts",
    "coverage:report": "node test/coverage/report-coverage.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
